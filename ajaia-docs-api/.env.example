# Copy to .env for local runs:  cp .env.example .env
# Every value is optional locally; defaults are shown. On a host (Render, Docker),
# set these as real environment variables instead of using a .env file.

# HTTP + WebSocket port
PORT=3000

# Signs session tokens (JWT). REQUIRED in production: random, 32+ characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Session timeout: ends after this many hours without activity...
SESSION_IDLE_HOURS=8
# ...and always this many days after sign-in.
SESSION_MAX_DAYS=7

# SQLite file (relative to ajaia-docs-api/)
DB_PATH=data/ajaia-docs.db

# Create the shared welcome document on an empty database
SEED_DEMO_DOCS=true

# Production builds use Secure cookies (HTTPS only). Set false only to serve a
# production build over plain HTTP.
# COOKIE_SECURE=true

# Folder of built UI files to serve (defaults to ../ajaia-docs-ui/dist/ajaia-docs-ui/browser)
# STATIC_DIR=
